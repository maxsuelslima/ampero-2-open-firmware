<?xml version="1.0" encoding="UTF-8"?>
<processor_spec>
  <!-- SHARC Processor Specification -->
  <description>Analog Devices SHARC (Super Harvard Architecture Computer) ADSP-21573 Processor</description>

  <endian>big</endian>
  <instruction_alignment>6</instruction_alignment>
  <default_code_alignment>6</default_code_alignment>
  <default_data_alignment>4</default_data_alignment>

  <!-- Address Spaces -->
  <address_space name="PM" space="PM" wordsize="6" pointer_size="4" addressable_unit="6" big_endian="true">
    <description>Program Memory - 48-bit wide instructions</description>
    <property name="is_code" value="true"/>
    <property name="is_default_code" value="true"/>
  </address_space>

  <address_space name="DM" space="DM" wordsize="4" pointer_size="4" addressable_unit="4" big_endian="true">
    <description>Data Memory - 32-bit wide data</description>
    <property name="is_data" value="true"/>
    <property name="is_default_data" value="true"/>
  </address_space>

  <address_space name="IO" space="IO" wordsize="4" pointer_size="4" addressable_unit="4" big_endian="true">
    <description>I/O Space - Peripheral registers</description>
    <property name="is_io" value="true"/>
  </address_space>

  <address_space name="register" space="register" wordsize="4" pointer_size="2" addressable_unit="4" big_endian="true">
    <description>Register File</description>
    <property name="is_register" value="true"/>
  </address_space>

  <address_space name="shadow" space="shadow" wordsize="4" pointer_size="2" addressable_unit="4" big_endian="true">
    <description>Shadow Register File (for interrupts)</description>
    <property name="is_register" value="true"/>
  </address_space>

  <!-- Registers -->
  <register name="R0"   space="register" offset="0x00" size="4" group="general"/>
  <register name="R1"   space="register" offset="0x04" size="4" group="general"/>
  <register name="R2"   space="register" offset="0x08" size="4" group="general"/>
  <register name="R3"   space="register" offset="0x0C" size="4" group="general"/>
  <register name="R4"   space="register" offset="0x10" size="4" group="general"/>
  <register name="R5"   space="register" offset="0x14" size="4" group="general"/>
  <register name="R6"   space="register" offset="0x18" size="4" group="general"/>
  <register name="R7"   space="register" offset="0x1C" size="4" group="general"/>
  <register name="R8"   space="register" offset="0x20" size="4" group="general"/>
  <register name="R9"   space="register" offset="0x24" size="4" group="general"/>
  <register name="R10"  space="register" offset="0x28" size="4" group="general"/>
  <register name="R11"  space="register" offset="0x2C" size="4" group="general"/>
  <register name="R12"  space="register" offset="0x30" size="4" group="general"/>
  <register name="R13"  space="register" offset="0x34" size="4" group="general"/>
  <register name="R14"  space="register" offset="0x38" size="4" group="general"/>
  <register name="R15"  space="register" offset="0x3C" size="4" group="general"/>

  <register name="S0"   space="register" offset="0x40" size="4" group="simd"/>
  <register name="S1"   space="register" offset="0x44" size="4" group="simd"/>
  <register name="S2"   space="register" offset="0x48" size="4" group="simd"/>
  <register name="S3"   space="register" offset="0x4C" size="4" group="simd"/>
  <register name="S4"   space="register" offset="0x50" size="4" group="simd"/>
  <register name="S5"   space="register" offset="0x54" size="4" group="simd"/>
  <register name="S6"   space="register" offset="0x58" size="4" group="simd"/>
  <register name="S7"   space="register" offset="0x5C" size="4" group="simd"/>
  <register name="S8"   space="register" offset="0x60" size="4" group="simd"/>
  <register name="S9"   space="register" offset="0x64" size="4" group="simd"/>
  <register name="S10"  space="register" offset="0x68" size="4" group="simd"/>
  <register name="S11"  space="register" offset="0x6C" size="4" group="simd"/>
  <register name="S12"  space="register" offset="0x70" size="4" group="simd"/>
  <register name="S13"  space="register" offset="0x74" size="4" group="simd"/>
  <register name="S14"  space="register" offset="0x78" size="4" group="simd"/>
  <register name="S15"  space="register" offset="0x7C" size="4" group="simd"/>

  <register name="F0"   space="register" offset="0x00" size="5" group="float40"/>
  <register name="F1"   space="register" offset="0x05" size="5" group="float40"/>
  <register name="F2"   space="register" offset="0x0A" size="5" group="float40"/>
  <register name="F3"   space="register" offset="0x0F" size="5" group="float40"/>
  <register name="F4"   space="register" offset="0x14" size="5" group="float40"/>
  <register name="F5"   space="register" offset="0x19" size="5" group="float40"/>
  <register name="F6"   space="register" offset="0x1E" size="5" group="float40"/>
  <register name="F7"   space="register" offset="0x23" size="5" group="float40"/>

  <register name="ASTAT"    space="register" offset="0x80" size="4" group="status"/>
  <register name="MODE1"   space="register" offset="0x84" size="4" group="control"/>
  <register name="MODE2"   space="register" offset="0x88" size="4" group="control"/>
  <register name="IRPTL"   space="register" offset="0x8C" size="4" group="interrupt"/>
  <register name="IMASK"   space="register" offset="0x90" size="4" group="interrupt"/>
  <register name="USTAT1"  space="register" offset="0x94" size="4" group="user"/>
  <register name="USTAT2"  space="register" offset="0x98" size="4" group="user"/>
  <register name="LCNTR"   space="register" offset="0x9C" size="4" group="loop"/>
  <register name="SYSCTL"  space="register" offset="0xA0" size="4" group="system"/>
  <register name="SP"      space="register" offset="0xA4" size="4" group="stack"/>
  <register name="SSP"     space="register" offset="0xA8" size="4" group="stack"/>
  <register name="LPSTACK" space="register" offset="0xAC" size="4" group="stack"/>
  <register name="FP"      space="register" offset="0xB0" size="4" group="frame"/>
  <register name="FPP"     space="register" offset="0xB4" size="4" group="frame"/>
  <register name="PC"      space="register" offset="0xB8" size="4" group="pc"/>
  <register name="PCSTK"   space="register" offset="0xBC" size="4" group="pc"/>
  <register name="PCSTKP"  space="register" offset="0xC0" size="4" group="pc"/>
  <register name="LADDR"   space="register" offset="0xC4" size="4" group="loop"/>
  <register name="CURLCNTR" space="register" offset="0xC8" size="4" group="loop"/>
  <register name="SYSCTL2" space="register" offset="0xCC" size="4" group="system"/>
  <register name="PMM"     space="register" offset="0xD0" size="4" group="bus"/>
  <register name="DMPM1"   space="register" offset="0xD4" size="4" group="bus"/>
  <register name="DMPM2"   space="register" offset="0xD8" size="4" group="bus"/>
  <register name="COREID"  space="register" offset="0xDC" size="4" group="id"/>
  <register name="CHIPID"  space="register" offset="0xE0" size="4" group="id"/>

  <!-- Stack pointer -->
  <stack_pointer register="SP" space="DM" growth="negative"/>
  <frame_pointer register="FP" space="DM"/>

  <!-- Program counter -->
  <program_counter register="PC" space="PM"/>

  <!-- Processor features -->
  <feature name="VLIW" value="true"/>
  <feature name="SIMD" value="true"/>
  <feature name="HARDWARE_LOOP" value="true"/>
  <feature name="CIRCULAR_BUFFER" value="true"/>
  <feature name="BIT_REVERSE" value="true"/>
  <feature name="SATURATION" value="true"/>
  <feature name="FLOAT32" value="true"/>
  <feature name="FLOAT40" value="true"/>
  <feature name="FIXED_POINT" value="true"/>
  <feature name="DUAL_CORE" value="true"/>

  <!-- Calling convention -->
  <calling_convention name="cdecl" spec="SHARC.cspec" proto="cdecl"/>
  <calling_convention name="dsp" spec="SHARC.cspec" proto="dsp_cdecl"/>
  <default_calling_convention name="cdecl"/>

  <!-- Instruction characteristics -->
  <instruction_size_min>6</instruction_size_min>
  <instruction_size_max>6</instruction_size_max>
  <instruction_alignment>6</instruction_alignment>

  <!-- Delay slots (SHARC has no traditional delay slots but has pipeline effects) -->
  <delay_slot_depth>0</delay_slot_depth>

  <!-- Stack frame -->
  <stack_frame>
    <min_frame_size>0</min_frame_size>
    <fixed_frame_size>0</fixed_frame_size>
    <return_address_register>PCSTK</return_address_register>
    <return_address_space>PM</return_address_space>
  </stack_frame>

  <!-- Context registers for analysis -->
  <context_register name="MODE1" space="register" offset="0x84" size="4"/>
  <context_register name="MODE2" space="register" offset="0x88" size="4"/>
  <context_register name="ASTAT" space="register" offset="0x80" size="4"/>

  <!-- Data types -->
  <data_type name="void" size="0" metatype="void"/>
  <data_type name="bool" size="1" metatype="bool"/>
  <data_type name="char" size="1" metatype="char"/>
  <data_type name="short" size="2" metatype="short"/>
  <data_type name="int" size="4" metatype="int"/>
  <data_type name="long" size="4" metatype="long"/>
  <data_type name="long long" size="8" metatype="longlong"/>
  <data_type name="float" size="4" metatype="float"/>
  <data_type name="double" size="8" metatype="double"/>
  <data_type name="long double" size="8" metatype="double"/>
  <data_type name="pointer" size="4" metatype="pointer"/>
  <data_type name="frac16" size="2" metatype="fractional"/>
  <data_type name="frac32" size="4" metatype="fractional"/>
  <data_type name="float40" size="5" metatype="float"/>

  <!-- Default prototype for decompiler -->
  <default_prototype>
    <name>cdecl</name>
  </default_prototype>

</processor_spec>